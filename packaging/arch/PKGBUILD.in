# Maintainer: Robert Green <robertrhysg@gmail.com>
pkgname=terminal-art-launcher
pkgver=0.2.0
pkgrel=1
pkgdesc='Terminal candy launcher, installer, and workspace presets for Arch Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/RobertRGreen/terminal-art-launcher'
license=('MIT')
depends=('glibc' 'gcc-libs' 'pacman')
makedepends=('cargo')
optdepends=(
  'sudo: install packages with pacman as a regular user'
  'kitty: save and restore terminal workspace presets'
  'hyprland: restore desktop workspace layouts'
  'yay: install terminal candy from the AUR'
  'paru: alternative AUR helper'
  'astroterm: animated terminal planetarium'
  'cmatrix: digital rain animation'
  'asciiquarium: ASCII aquarium'
  'cava: audio spectrum visualizer'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/art "$pkgdir/usr/bin/art"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/presets.md "$pkgdir/usr/share/doc/$pkgname/presets.md"
  install -Dm644 docs/art.1 "$pkgdir/usr/share/man/man1/art.1"
  install -Dm644 packaging/arch/art.desktop "$pkgdir/usr/share/applications/art.desktop"
}
